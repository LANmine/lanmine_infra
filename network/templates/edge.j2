! {{ inventory_hostname }} — edge access switch (Cisco IOS)
! Rendered from git. Do not edit on the device.
hostname {{ inventory_hostname }}
ip domain name {{ domain_name }}
!
{% for id, name in vlans.items() %}
vlan {{ id }}
 name {{ name }}
{% endfor %}
!
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
{% if snmp_community %}
snmp-server community {{ snmp_community }} RO
{% endif %}
!
{% if mgmt_vlan is defined and mgmt_vlan %}
! In-band management SVI on the fabric mgmt VLAN (mgmt_vlan: 200) — reachable
! from the servers network through the gateways. OOB VLAN 100 is retired; the
! gateway's *own* management is OOB (Gi0/0 Mgmt-vrf) on a different address.
interface Vlan{{ mgmt_vlan }}
 description management
 ip address {{ mgmt_ip | default(ansible_host) }} 255.255.255.0
 no shutdown
!
{% endif %}
! DHCP snooping + DAI protect the DHCP-served segments (participant + wifi).
! Bindings are built from DHCP traffic on the trusted uplink; edge ports stay
! untrusted and are rate-limited, and ARP is validated against the bindings.
ip dhcp snooping
ip dhcp snooping vlan {{ access_vlan }},{{ wifi_vlan }}
ip arp inspection vlan {{ access_vlan }},{{ wifi_vlan }}
!
interface range {{ access_ports }}
 description participant
 switchport mode access
 switchport access vlan {{ access_vlan }}
 ! DHCP-served port (auto via gateway DHCP, not static) — untrusted by default
 ! for snooping/DAI: rate-limit DHCP and validate ARP below, with port-security
 ! + storm-control as the outer layer.
 switchport port-security
 switchport port-security maximum 2
 switchport port-security violation restrict
 switchport port-security mac-address sticky
 spanning-tree portfast
 spanning-tree bpduguard enable
 ip dhcp snooping limit rate 10
 ip arp inspection limit rate 15
 storm-control broadcast level 1
!
{% if ap_ports is defined and ap_ports %}
! AP ports — FlexConnect trunk: native ap-mgmt VLAN ({{ ap_mgmt_vlan }}), tagged
! wifi VLAN ({{ wifi_vlan }}). Untrusted for snooping/DAI like any edge port:
! clients sit behind the AP and get DHCP there.
interface range {{ ap_ports }}
 description ap
 switchport mode trunk
 switchport trunk native vlan {{ ap_mgmt_vlan }}
 switchport trunk allowed vlan {{ ap_mgmt_vlan }},{{ wifi_vlan }}
 spanning-tree portfast
 spanning-tree bpduguard enable
!
{% endif %}
interface {{ uplink_interface }}
 description uplink-to-core
 switchport mode trunk
 switchport trunk allowed vlan {{ uplink_allowed_vlans }}
 ! Toward the DHCP server / gateway — trust snooping + DAI here.
 ip dhcp snooping trust
 ip arp inspection trust
!
