! {{ inventory_hostname }} — edge access switch (Cisco IOS, WS-C2960X)
! Rendered from git. Do not edit on the device.
hostname {{ inventory_hostname }}
ip domain name {{ domain_name }}
!
{% for id, name in vlans.items() %}
vlan {{ id }}
 name {{ name }}
{% endfor %}
!
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
{% if snmp_community %}
snmp-server community {{ snmp_community }} RO
{% endif %}
!
! Legacy management segment (VLAN 50 / 172.16.1.0/25). These switches come with
! this address baked in — kept as-is so they are reachable without a factory
! reset. The gateway (172.16.1.1) is the HSRP VIP on gw1/gw2 Vlan50.
interface Vlan50
 description legacy-mgmt
 ip address {{ ansible_host }} 255.255.255.128
 no shutdown
!
ip default-gateway 172.16.1.1
!
! Participant access ports — all copper GigabitEthernet ports.
! portfast + bpduguard: no switches should ever be plugged in here.
! storm-control at 10% is a loose cap that stops broadcast storms without
! impacting normal LAN traffic bursts.
interface range {{ access_ports }}
 switchport mode access
 switchport access vlan {{ access_vlan }}
 spanning-tree portfast
 spanning-tree bpduguard enable
 storm-control broadcast level 10.00
 storm-control multicast level 10.00
!
! Dual 10G uplinks to the core switches (one to core1, one to core2).
! Native VLAN 50 matches the cores' expectation and carries the management
! segment untagged so the switch is reachable even if VLAN tagging breaks.
{% for uplink in uplink_interfaces %}
interface {{ uplink }}
 description uplink-to-core
 switchport mode trunk
 switchport trunk native vlan 50
 switchport trunk allowed vlan {{ uplink_allowed_vlans }}
!
{% endfor %}
! AAA: local auth only. Required for SSH pubkey-chain to activate.
aaa new-model
aaa authentication login default local
aaa authorization exec default local
!
